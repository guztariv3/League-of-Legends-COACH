{
  "name": "lol-coach",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @coach/web e2e",
    "dev:api": "pnpm --filter @coach/api dev",
    "dev:web": "pnpm --filter @coach/web dev",
    "build": "pnpm --filter @coach/web build",
    "check": "pnpm typecheck && pnpm test",
    "test:e2e:desktop": "pnpm --filter @coach/desktop e2e"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
