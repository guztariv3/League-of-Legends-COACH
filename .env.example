# API (apps/api). Everything is optional: with no values the app runs on synthetic data with an embedded database.
# DATABASE_URL=postgres://user:pass@host:5432/coach   # real Postgres; otherwise embedded PGlite in .data/pglite
# RIOT_API_KEY=RGAPI-...                              # enables real Riot data (Data Dragon + match-v5)
# ANTHROPIC_API_KEY=...                               # enables AI-written explanations (otherwise deterministic text)
# AI_MODEL=claude-opus-5                              # decision D-07 (default)
# DEV_LOGIN=1                                         # development login; in production only together with PROTOTYPE_PASSWORD
# PROTOTYPE_PASSWORD=...                              # ≥12 chars: gates the whole site (HTTP Basic, user "kairos")
# WEB_DIST=apps/web/dist                              # serve the built web app from the API (production image sets it)
# WEB_ORIGIN=http://localhost:5173
# PORT=8787
