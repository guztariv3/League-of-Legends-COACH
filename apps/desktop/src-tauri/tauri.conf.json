{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KOI Master",
  "version": "0.1.0",
  "identifier": "app.kairoscoach.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "live",
        "title": "KOI Master \u00b7 Live Coach",
        "width": 380,
        "height": 560,
        "minWidth": 300,
        "minHeight": 360,
        "resizable": true,
        "alwaysOnTop": true,
        "focus": false
      },
      {
        "label": "overlay",
        "title": "KOI Master \u00b7 Overlay",
        "url": "overlay.html",
        "width": 230,
        "height": 250,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://ddragon.leagueoflegends.com; connect-src 'self' ipc: http://ipc.localhost https://ddragon.leagueoflegends.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
